# Camera DHCP reservations owned by Bittern.
#
# Each entry pins a camera MAC to the address from appliance.yaml. dnsmasq
# excludes a reserved address from dynamic allocation, so a camera adopted
# while it held a pool lease keeps that address. This file is generated; a
# reservation written by hand belongs in another file and is not Bittern's.
{{range .Reservations}}dhcp-host={{ .MAC }},{{ .Address }}
{{end}}
