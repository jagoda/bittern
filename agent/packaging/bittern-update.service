# Fixed app bundle update worker. The agent writes /var/lib/bittern/update/request.json and starts
# this unit. ExecStart is the fixed launcher, installed at /usr/libexec/bittern/bittern-update. It
# execs the active bundle's verified usr/bin/bittern, falling back to the installed /usr/bin/bittern
# baseline when no bundle is active or the pointer cannot be read, exactly as bitternd.service does.
# The unit passes only the fixed "update helper" arguments; no argument, environment file, or
# property is user-controlled. The beta preparation kit installs it and the image keeps it.
[Unit]
Description=Bittern app bundle update
Documentation=file:/usr/share/doc/bittern/README.md
After=local-fs.target bittern-first-boot.service bitternd.service
ConditionPathExists=/var/lib/bittern/update/request.json
RequiresMountsFor=/etc/bittern /var/lib/bittern

[Service]
Type=oneshot
ExecStart=/usr/libexec/bittern/bittern-update update helper
TimeoutStartSec=2h
Restart=no
User=root
Group=root
UMask=0077
StateDirectory=bittern

# The transaction writes its own state under /var/lib/bittern, the apply target map's live files
# under /etc, and the declared /etc/systemd/system/bittern-bundle-* unit files with their wants
# links. The fixed apply target map and the unit allowlist are the code-enforced boundary; /etc is
# writable because an atomic replacement creates its temporary file beside the target. The live
# appliance.yaml is still written by the agent after commit, not by this helper.
ReadWritePaths=/etc /var/lib/bittern

# The helper needs to see /dev/dri and /sys/firmware for the read-only base fingerprint, so
# PrivateDevices is deliberately absent. It runs systemctl as a D-Bus client, docker through the
# socket, sqlite3 on regular files, and the native checkers, so it needs no capability. AF_NETLINK
# lets nft -c ask the kernel to validate the ruleset; without CAP_NET_ADMIN the checker reports the
# environment skip the apply pipeline already records instead of a false pass.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
NoNewPrivileges=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
