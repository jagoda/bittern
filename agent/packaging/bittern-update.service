# Fixed app bundle update worker. The agent writes /var/lib/bittern/update/request.json and starts
# this unit. The unit takes no arguments, no environment file, and no user-controlled property; the
# helper reads the request record and exits. The beta preparation kit installs it and the image keeps it.
[Unit]
Description=Bittern app bundle update
Documentation=file:/usr/share/doc/bittern/README.md
After=local-fs.target bittern-first-boot.service bitternd.service
ConditionPathExists=/var/lib/bittern/update/request.json
RequiresMountsFor=/etc/bittern /var/lib/bittern

[Service]
Type=oneshot
ExecStart=/usr/bin/bittern update helper
TimeoutStartSec=2h
Restart=no
User=root
Group=root
UMask=0077
StateDirectory=bittern

# The transaction writes its own state under /var/lib/bittern and, during the apply-config
# step, the apply target map's live files under /etc. The fixed target map is the allowlist;
# /etc is writable because an atomic replacement creates its temporary file beside the target.
# The live appliance.yaml is still written by the agent after commit, not by this helper.
ReadWritePaths=/etc /var/lib/bittern

# The helper needs to see /dev/dri and /sys/firmware for the read-only base fingerprint, so
# PrivateDevices is deliberately absent. It runs systemctl as a D-Bus client, docker through the
# socket, sqlite3 on regular files, and the native checkers, so it needs no capability. AF_NETLINK
# lets nft -c ask the kernel to validate the ruleset; without CAP_NET_ADMIN the checker reports the
# environment skip the apply pipeline already records instead of a false pass.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
NoNewPrivileges=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
