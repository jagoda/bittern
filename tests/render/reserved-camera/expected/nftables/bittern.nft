# Generated by Bittern from appliance.yaml; do not edit.
# appliance.yaml schema version: 2

# Input and forward default to deny (ADR 0005). There is no NAT table: cam0 is
# an isolated segment, not a routed network.
table inet bittern {
    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop
        iifname "lo" accept

        # DHCP client on the house LAN.
        iifname "lan0" udp dport 68 accept

        # IPv6 neighbour discovery on the LAN, if the LAN provides IPv6.
        iifname "lan0" icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept

        # Bittern UI over TLS on 443 (ADR 0019). It is the only browser-facing
        # surface on the house LAN.
        iifname "lan0" tcp dport 443 accept

        # Frigate's UI is loopback-only (ADR 0016), not a LAN or tailnet service.
        # The support path is an ADR 0016 follow-up and the live-video path is
        # OQ-03, so 8555 stays closed.

        # Unauthenticated upstream ports and the RTSP restream stay closed.
        # OQ-15 is not decided: 8554 remains closed by default until it is.
        iifname "cam0" tcp dport { 1984, 5000, 8554, 8555, 8971 } drop
        iifname "lan0" tcp dport { 1984, 5000, 8554, 8555, 8971 } drop
        iifname "cam0" udp dport 8555 drop
        iifname "lan0" udp dport 8555 drop

        # Cameras get DHCP and NTP only. cam0 has no DNS service.
        iifname "cam0" udp dport 67 accept
        iifname "cam0" udp dport 123 accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        # No forwarding between cam0 and lan0, no camera WAN rule, and no NAT.
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
